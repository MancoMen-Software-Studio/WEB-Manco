# Resend API Key — get yours at https://resend.com/api-keys
RESEND_API_KEY=

# From email — must be a verified domain in Resend, or use onboarding@resend.dev for testing
RESEND_FROM_EMAIL=onboarding@resend.dev

# Where contact form submissions are sent
CONTACT_EMAIL=macomenstudio@icloud.com

# Resend Audience ID for waitlist — create one at resend.com/audiences (optional)
# If not set, signups are only emailed to CONTACT_EMAIL
RESEND_AUDIENCE_ID=
